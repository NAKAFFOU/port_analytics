# Application
PORT_ANALYTICS_SETTINGS=config/settings.yaml
LOG_LEVEL=INFO

# Data source selection for src/pipeline/runner.py (--source overrides this).
# - synthetic: seeded demo data, no external connection, safe for tests/CI.
# - oracle: extracts the five PBI_JDE analytical views over python-oracledb.
DATA_SOURCE=synthetic
KEEP_SYNTHETIC_DEMO_MODE=true

# --- Oracle / JD Edwards (PBI_JDE analytical views) -------------------------
# DSN resolution priority: ORACLE_DSN > ORACLE_HOST+ORACLE_PORT+ORACLE_SERVICE
# > ORACLE_HOST+ORACLE_PORT+ORACLE_SID. Fill in exactly one of ORACLE_DSN,
# ORACLE_SERVICE or ORACLE_SID alongside ORACLE_HOST/ORACLE_PORT.
# Real values belong in your local .env only (gitignored) — never here.
ORACLE_USER=CHANGE_ME
ORACLE_PASSWORD=CHANGE_ME

ORACLE_HOST=CHANGE_ME
ORACLE_PORT=1521
ORACLE_SERVICE=
ORACLE_SID=CHANGE_ME
ORACLE_DSN=
ORACLE_SCHEMA=PBI_JDE

# Thin mode (pure Python, no Oracle Client) is used unless this is true AND
# ORACLE_CLIENT_LIB_DIR points to an installed Oracle Instant Client.
ORACLE_THICK_MODE=false
ORACLE_CLIENT_LIB_DIR=

ORACLE_FETCH_SIZE=5000
ORACLE_QUERY_TIMEOUT=120

# JDE CHAR/NCHAR columns are fixed-width and space-padded; trim on read.
TRIM_ORACLE_TEXT=true

# The PBI_JDE views expose no currency column. This must be set explicitly —
# it is never guessed. MONTANT is otherwise loaded exactly as returned by
# Oracle (already inverted, /100-scaled and rounded at the view level).
SOURCE_CURRENCY=XOF
DISPLAY_CURRENCY=GBP

# --- Legacy JD Edwards direct-table adapter (config/sources/jde_oracle.yaml) -
# Kept as-is; this adapter has its own env var names and is unaffected by
# the ORACLE_* block above. Real values belong in your local .env only.
SOURCE_DB_HOST=CHANGE_ME
SOURCE_DB_PORT=1521
SOURCE_DB_SERVICE=CHANGE_ME
SOURCE_DB_USER=CHANGE_ME
SOURCE_DB_PASSWORD=CHANGE_ME
SOURCE_DB_SCHEMA=PBI_JDE
SOURCE_DB_DEFAULT_CURRENCY=XOF

# Dashboard
STREAMLIT_SERVER_ADDRESS=127.0.0.1
STREAMLIT_SERVER_PORT=8501

# Oracle integration tests (tests/test_oracle_integration.py) are skipped
# unless this is true AND the ORACLE_* variables above are filled in with a
# reachable instance. Never enable this in CI without a real Oracle target.
RUN_ORACLE_INTEGRATION_TESTS=false
